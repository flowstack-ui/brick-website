{
  "name": "@flowstack-ui/brick-website",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "predev": "npm run content:check",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev --host 127.0.0.1 --port 3012",
    "dev:network": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev --host 0.0.0.0 --port 3012",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "content:sync": "node scripts/sync-brick-docs.mjs",
    "content:check": "node scripts/check-content.mjs",
    "verify:repository-contract": "node scripts/verify-repository-contract.mjs",
    "check:focused": "npm run content:check && npm run typecheck",
    "check:repository": "npm run verify:repository-contract && npm run content:check && npm run typecheck && npm run lint && npm run build && node --test tests/rendered-html.test.mjs",
    "verify": "npm run check:repository",
    "test:all": "npm run check:repository"
  },
  "dependencies": {
    "@flowstack-ui/brick": "0.1.0",
    "lucide-react": "^1.24.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
