{
  "name": "@flowstack-ui/brick-website",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "browserslist": [
    "chrome 111",
    "edge 111",
    "firefox 111",
    "safari 16.4",
    "ios_saf 16.4"
  ],
  "scripts": {
    "predev": "npm run content:check && npm run styles:sync",
    "predev:network": "npm run content:check && npm run styles:sync",
    "dev": "next dev --hostname 127.0.0.1 --port 3012",
    "dev:network": "next dev --hostname 0.0.0.0 --port 3012",
    "prebuild": "npm run styles:sync",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3012",
    "start:test": "next start --hostname 127.0.0.1 --port 4012",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "content:sync": "node scripts/sync-brick-docs.mjs && npm run search:sync && npm run syntax:sync",
    "content:check": "node scripts/check-content.mjs && npm run search:check && npm run syntax:check",
    "search:sync": "node scripts/generate-search-index.mjs",
    "search:check": "node scripts/generate-search-index.mjs --check",
    "syntax:sync": "node scripts/generate-syntax-tokens.mjs",
    "syntax:check": "node scripts/generate-syntax-tokens.mjs --check",
    "styles:sync": "node scripts/generate-brick-style-bundles.mjs",
    "theme:check": "node scripts/check-theme-contrast.mjs",
    "performance:check": "node scripts/check-performance.mjs",
    "verify:repository-contract": "node scripts/verify-repository-contract.mjs",
    "check:focused": "npm run content:check && npm run typecheck",
    "check:repository": "npm run verify:repository-contract && npm run content:check && npm run theme:check && npm run typecheck && npm run lint && npm run build && npm run performance:check && node --test tests/rendered-html.test.mjs",
    "verify": "npm run check:repository",
    "test:all": "npm run check:repository"
  },
  "dependencies": {
    "@flowstack-ui/brick": "0.1.5",
    "@primer/octicons-react": "^19.32.0",
    "@vercel/analytics": "^2.0.1",
    "lucide-react": "^1.24.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@shikijs/langs": "^4.4.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "shiki": "^4.4.1",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  },
  "type": "module"
}
